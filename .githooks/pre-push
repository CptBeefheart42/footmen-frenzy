#!/usr/bin/env python3
"""Before every push (ff setup turns this hook on): no commit about to be pushed names a private word from
ff.local.json as its author or committer, since commits are published with every name and address they carry."""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools' / 'ff'))
import leaks  # noqa: E402

ZERO = '0' * 40
remote = sys.argv[1] if len(sys.argv) > 1 else ''
found = []
for line in sys.stdin:
    local_ref, local_sha, remote_ref, remote_sha = line.split()
    if local_sha == ZERO:
        continue  # a deleted branch carries no commits
    revisions = [local_sha, '--not', '--remotes=' + remote] if remote_sha == ZERO else [f'{remote_sha}..{local_sha}']
    found += [f'{remote_ref}: {f}' for f in leaks.identity_findings(leaks.pushed_identities(revisions))]
if found:
    print('pre-push: commits to push name private details:\n' + '\n'.join(found) +
          '\nrewrite them with your GitHub no-reply identity first; nothing was pushed')
    sys.exit(1)
