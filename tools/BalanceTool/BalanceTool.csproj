<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- Lint gate: a compiler warning fails the build (the checks build both tools) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BalanceTool</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="War3Net.Build" Version="6.1.2" />
    <PackageReference Include="War3Net.Build.Core" Version="6.1.2" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- shared with tools/runner: the WC3 3.0 level fill and the repository lookup -->
    <Compile Include="../shared/AbilityLevelFill.cs" Link="Shared/AbilityLevelFill.cs" />
    <Compile Include="../shared/Repo.cs" Link="Shared/Repo.cs" />
  </ItemGroup>
</Project>
