// FF 3.0 probe (ff e2e probe; a diagnostic map, NEVER released) — tables and the read-back pass.
//
// The probe build stubs the map's own triggers (InitCustomTriggers, RunInitializationTriggers) and adds
// these map addons. 60-probe-data.j is generated by tools/probe/gen_probe.py from the map's object data:
// it fills the tables below. 65-probe-run.j runs the read-back and the functional tests and writes the
// results to CustomMapData\ff_probe.txt.

globals
    // ability cells to read back (see gen_probe.py for the classes)
    integer FF_PB_n = 0
    integer array FF_PB_abil
    integer array FF_PB_field
    integer array FF_PB_level
    integer array FF_PB_kind
    integer array FF_PB_cls
    real array FF_PB_exp
    real array FF_PB_def
    // negative ward-aura values the restore test writes back with natives
    integer FF_PB_rn = 0
    integer array FF_PB_rAbil
    integer array FF_PB_rField
    integer array FF_PB_rLevel
    real array FF_PB_rVal
    // unit fields outside the metadata limits
    integer FF_PB_un = 0
    integer array FF_PB_uUnit
    integer array FF_PB_uField
    integer array FF_PB_uKind
    real array FF_PB_uExp
    real array FF_PB_uDef
    // units with a blank ability list: the base unit's default abilities to look for
    integer FF_PB_an = 0
    integer array FF_PB_aUnit
    integer array FF_PB_aAbil
    // results: FF_PB_cnt[class * 8 + result], result 0 ok / 1 zero / 2 default / 3 other / 4 unreadable / 5 no ability
    integer array FF_PB_cnt
    string array FF_PB_out
    integer FF_PB_outN = 0
    integer FF_PB_mis = 0
    integer FF_PB_i = 0
    unit FF_PB_dummy = null
    integer FF_PB_curAbil = 0
    ability FF_PB_curAb = null
    integer FF_PB_grpAbil = 0
    integer FF_PB_grpField = 0
    integer FF_PB_grpState = 0
endglobals

function FF_PB_Add takes integer abil, integer field, integer level, integer kind, integer cls, real exp, real def returns nothing
    set FF_PB_abil[FF_PB_n] = abil
    set FF_PB_field[FF_PB_n] = field
    set FF_PB_level[FF_PB_n] = level
    set FF_PB_kind[FF_PB_n] = kind
    set FF_PB_cls[FF_PB_n] = cls
    set FF_PB_exp[FF_PB_n] = exp
    set FF_PB_def[FF_PB_n] = def
    set FF_PB_n = FF_PB_n + 1
endfunction

function FF_PB_Restore takes integer abil, integer field, integer level, real value returns nothing
    set FF_PB_rAbil[FF_PB_rn] = abil
    set FF_PB_rField[FF_PB_rn] = field
    set FF_PB_rLevel[FF_PB_rn] = level
    set FF_PB_rVal[FF_PB_rn] = value
    set FF_PB_rn = FF_PB_rn + 1
endfunction

function FF_PB_UnitField takes integer unitId, integer field, integer kind, real exp, real def returns nothing
    set FF_PB_uUnit[FF_PB_un] = unitId
    set FF_PB_uField[FF_PB_un] = field
    set FF_PB_uKind[FF_PB_un] = kind
    set FF_PB_uExp[FF_PB_un] = exp
    set FF_PB_uDef[FF_PB_un] = def
    set FF_PB_un = FF_PB_un + 1
endfunction

function FF_PB_UnitAbil takes integer unitId, integer abil returns nothing
    set FF_PB_aUnit[FF_PB_an] = unitId
    set FF_PB_aAbil[FF_PB_an] = abil
    set FF_PB_an = FF_PB_an + 1
endfunction

// 'A0F0' -> "A0F0" (rawcodes are big-endian: the lowest byte is the last character)
function FF_PB_Id2S takes integer id returns string
    local string cs = "0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz"
    local string s = ""
    local integer i = 0
    local integer b
    loop
        exitwhen i >= 4
        set b = ModuloInteger(id, 256)
        set id = id / 256
        if b >= 48 and b <= 122 then
            set s = SubString(cs, b - 48, b - 47) + s
        elseif b != 0 then
            set s = "?" + s
        endif
        set i = i + 1
    endloop
    return s
endfunction

function FF_PB_R takes real x returns string
    return R2SW(x, 1, 3)
endfunction

function FF_PB_B2S takes boolean b returns string
    if b then
        return "true"
    endif
    return "false"
endfunction

function FF_PB_Near takes real a, real b returns boolean
    return RAbsBJ(a - b) <= 0.0005 + 0.0005 * RAbsBJ(b)
endfunction

function FF_PB_Log takes string s returns nothing
    if FF_PB_outN < 700 then
        set FF_PB_out[FF_PB_outN] = s
        set FF_PB_outN = FF_PB_outN + 1
    endif
endfunction

function FF_PB_ReadValue takes ability ab, integer kind, integer field, integer level returns real
    if kind == 0 then
        return I2R(BlzGetAbilityIntegerLevelField(ab, ConvertAbilityIntegerLevelField(field), level - 1))
    elseif kind == 1 then
        return BlzGetAbilityRealLevelField(ab, ConvertAbilityRealLevelField(field), level - 1)
    endif
    if BlzGetAbilityBooleanLevelField(ab, ConvertAbilityBooleanLevelField(field), level - 1) then
        return 1.0
    endif
    return 0.0
endfunction

// One read-back step per entry: a dummy carries one ability at a time; entries arrive grouped by ability
// and field with the group's control row first. A group whose control doesn't read back is "unreadable"
// (the native doesn't expose that field), so its other rows can't be judged.
function FF_PB_ReadEntries takes integer budget returns boolean
    local integer i
    local integer res
    local real got
    loop
        exitwhen budget <= 0 or FF_PB_i >= FF_PB_n
        set i = FF_PB_i
        if FF_PB_abil[i] != FF_PB_curAbil then
            if FF_PB_curAbil != 0 then
                call UnitRemoveAbility(FF_PB_dummy, FF_PB_curAbil)
            endif
            set FF_PB_curAbil = FF_PB_abil[i]
            call UnitAddAbility(FF_PB_dummy, FF_PB_curAbil)
            set FF_PB_curAb = BlzGetUnitAbility(FF_PB_dummy, FF_PB_curAbil)
        endif
        if FF_PB_abil[i] != FF_PB_grpAbil or FF_PB_field[i] != FF_PB_grpField then
            set FF_PB_grpAbil = FF_PB_abil[i]
            set FF_PB_grpField = FF_PB_field[i]
            set FF_PB_grpState = 0
        endif
        set got = 0.0
        if FF_PB_curAb == null then
            set res = 5
        else
            set got = FF_PB_ReadValue(FF_PB_curAb, FF_PB_kind[i], FF_PB_field[i], FF_PB_level[i])
            if FF_PB_Near(got, FF_PB_exp[i]) then
                set res = 0
            elseif FF_PB_cls[i] > 1 and FF_PB_grpState != 1 then
                set res = 4
            elseif FF_PB_Near(got, 0.0) then
                set res = 1
            elseif FF_PB_Near(got, FF_PB_def[i]) then
                set res = 2
            else
                set res = 3
            endif
            if FF_PB_cls[i] <= 1 then
                if res == 0 then
                    set FF_PB_grpState = 1
                else
                    set FF_PB_grpState = 2
                endif
            endif
        endif
        set FF_PB_cnt[FF_PB_cls[i] * 8 + res] = FF_PB_cnt[FF_PB_cls[i] * 8 + res] + 1
        if res != 0 and res != 4 and FF_PB_mis < 300 then
            set FF_PB_mis = FF_PB_mis + 1
            call FF_PB_Log("R " + FF_PB_Id2S(FF_PB_abil[i]) + " " + FF_PB_Id2S(FF_PB_field[i]) + " L" + I2S(FF_PB_level[i]) + " c" + I2S(FF_PB_cls[i]) + " r" + I2S(res) + " exp=" + FF_PB_R(FF_PB_exp[i]) + " got=" + FF_PB_R(got) + " def=" + FF_PB_R(FF_PB_def[i]))
        endif
        set FF_PB_i = FF_PB_i + 1
        set budget = budget - 1
    endloop
    return FF_PB_i >= FF_PB_n
endfunction
